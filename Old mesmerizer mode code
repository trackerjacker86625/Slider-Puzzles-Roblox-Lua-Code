local function destroyCirclePuzzle()
	if timerRunning then
		stopTimer()
	end
	-- disconnect listeners
	for tile, conns in pairs(tileConnections) do
		for _, conn in ipairs(conns) do
			conn:Disconnect()
		end
	end
	tileConnections = {}

	-- destroy tiles
	for _, child in ipairs(board:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	-- clear tables
	tileOrder = {}
	tileIndex = {}
	correctIndexMap = {}
	tileGrid = {}
	tileRC = {}
	emptyIndex = nil
end
gui:GetPropertyChangedSignal("Enabled"):Connect(function()
	if gui.Enabled then
		circleActive = true
		rebuild()
	else
		circleActive = false
		destroyCirclePuzzle()
	end
end)

