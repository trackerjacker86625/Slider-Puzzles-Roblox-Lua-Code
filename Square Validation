---------------
-- AUTOBAN (only for truly impossible states)
---------------
local function autoban(player, reason)
	warn("AUTOBAN:", player.Name, reason)

	pcall(function()
		banStore:SetAsync(player.UserId, {
			reason = reason,
			time = os.time()
		})
	end)

	player:Kick("You have been permanently banned for cheating.\nReason: " .. reason)
end

----------
-- HELPERS
----------
local function sameRow(i1, i2, cols)
	return math.ceil(i1 / cols) == math.ceil(i2 / cols)
end

local function sameColumn(i1, i2, cols)
	return ((i1 - 1) % cols) == ((i2 - 1) % cols)
end

local function isSolved(board)
	for i = 1, #board do
		if board[i] ~= i then
			return false
		end
	end
	return true
end
local function countCorrectTiles(board)
	local correct = 0
	for i = 1, #board - 1 do
		if board[i] == i then
			correct += 1
		end
	end
	return correct
end
-------------
-- SERVER SHUFFLE
-------------
local function shuffle2x2Server()
	local rows, cols = 2, 2
	local totalTiles = 4

	-- Start solved
	local arr = {1, 2, 3, 4}
	local emptyIndex = 4

	-- Random walk
	local rng = Random.new()
	local moveCount = 20

	local function getValidMoves(idx)
		local moves = {}
		if idx > cols then table.insert(moves, idx - cols) end
		if idx <= totalTiles - cols then table.insert(moves, idx + cols) end
		if (idx - 1) % cols ~= 0 then table.insert(moves, idx - 1) end
		if idx % cols ~= 0 then table.insert(moves, idx + 1) end
		return moves
	end

	for i = 1, moveCount do
		local moves = getValidMoves(emptyIndex)
		local target = moves[rng:NextInteger(1, #moves)]
		arr[emptyIndex], arr[target] = arr[target], arr[emptyIndex]
		emptyIndex = target
	end

	return arr
end

local function generateSolvableLayout(rows, cols)
	if rows == 2 and cols == 2 then
		return shuffle2x2Server()
	end
	local totalTiles = rows * cols
	local g = totalTiles - 1
	local rng = Random.new()

	while true do
		-- build arr normally (your existing code)
		local arr = {}
		for i = 1, g do arr[i] = i end

		local parity = false
		for i = 1, g - 2 do
			local t = rng:NextInteger(i, g)
			if i ~= t then parity = not parity end
			arr[i], arr[t] = arr[t], arr[i]
		end

		if parity then
			arr[g - 1], arr[g] = arr[g], arr[g - 1]
		end

		table.insert(arr, totalTiles)

		-- random blank movement (your existing code)
		local d = rng:NextInteger(0, rows - 1)
		local r = rng:NextInteger(0, cols - 1)
		local blankIndex = totalTiles

		for _ = 1, d do
			arr[blankIndex], arr[blankIndex - cols] = arr[blankIndex - cols], arr[blankIndex]
			blankIndex -= cols
		end

		for _ = 1, r do
			arr[blankIndex], arr[blankIndex - 1] = arr[blankIndex - 1], arr[blankIndex]
			blankIndex -= 1
		end

		-- minimum scramble check
		local correct = countCorrectTiles(arr)
		if correct <= (totalTiles / 2) then
			return arr
		end

		-- otherwise loop again and reshuffle
	end
end

------------
-- SLIDE LOGIC
------------
local function computeSlide(board, clickedIndex, emptyIndex, rows, cols)
	if clickedIndex == emptyIndex then
		return board, emptyIndex, 0
	end

	if not (sameRow(clickedIndex, emptyIndex, cols) or sameColumn(clickedIndex, emptyIndex, cols)) then
		return nil, nil, nil
	end

	local direction = clickedIndex > emptyIndex and 1 or -1
	local step = sameRow(clickedIndex, emptyIndex, cols) and 1 or cols

	local current = emptyIndex
	local swaps = {}

	while current ~= clickedIndex do
		local nextIndex = current + step * direction
		table.insert(swaps, {from = current, to = nextIndex})
		current = nextIndex
	end

	for _, s in ipairs(swaps) do
		board[s.from], board[s.to] = board[s.to], board[s.from]
	end

	local movedCount = math.abs(clickedIndex - emptyIndex) / step
	return board, clickedIndex, movedCount
end

--------------
-- PUZZLE START
--------------
PuzzleStart.OnServerEvent:Connect(function(player, rows, cols, puzzleMode, blindfoldEnabled)
	-- Basic validation
	if typeof(rows) ~= "number" or typeof(cols) ~= "number" then return end
	if rows < 2 or cols < 2 then
		autoban(player, "Invalid puzzle dimensions (too small)")
		return
	end

	if rows > 30 or cols > 30 then
		autoban(player, "Invalid puzzle dimensions (too large)")
		return
	end
	if typeof(puzzleMode) ~= "string" then return end
	if typeof(blindfoldEnabled) ~= "boolean" then return end

	local layout = generateSolvableLayout(rows, cols)
	local totalTiles = rows * cols

	local emptyIndex
	for i = 1, totalTiles do
		if layout[i] == totalTiles then
			emptyIndex = i
			break
		end
	end

	-- This should never fail; if it does, it's server-side
	if not emptyIndex then
		warn("Internal error: No blank tile in generated layout for", player.Name)
		return
	end

	-- Overwrite any previous puzzle safely
	activePuzzle[player] = {
		rows = rows,
		cols = cols,
		mode = puzzleMode,
		blindfold = blindfoldEnabled,
		startTime = blindfoldEnabled and tick() or 0,
		completed = false,
		board = layout,
		emptyIndex = emptyIndex,
		moves = 0,
	}

	-- Client builds board in solved order, then applies layout
	PuzzleInit:FireClient(player, rows, cols, layout)
end)

------
-- REQUEST SLIDE
------
local HttpService = game:GetService("HttpService")

RequestSlide.OnServerEvent:Connect(function(player, clickedIndex)
	local active = activePuzzle[player]

	-- Desync or manual firing: ignore, no autoban
	if not active then
		return
	end

	-- Puzzle already completed: ignore further moves
	if active.completed then
		return
	end

	-- Basic type validation
	if typeof(clickedIndex) ~= "number" then
		warn(player.Name, "sent RequestSlide with non-number index")
		return
	end

	local rows = active.rows
	local cols = active.cols
	local totalTiles = rows * cols

	-- Range validation
	if clickedIndex < 1 or clickedIndex > totalTiles then
		warn(player.Name, "sent RequestSlide out-of-range index", clickedIndex)
		return
	end

	-- Clone board to avoid race conditions
	local function cloneBoard(board)
		local new = {}
		for i, v in ipairs(board) do
			new[i] = v
		end
		return new
	end

	local board = cloneBoard(active.board)
	local emptyIndex = active.emptyIndex

	-- Compute slide
	local newBoard, newEmptyIndex, movedCount =
		computeSlide(board, clickedIndex, emptyIndex, rows, cols)

	-- Illegal move: ignore
	if not newBoard then
		return
	end

	-- Start timer on first REAL move (non-blindfold)
	if not active.blindfold and active.moves == 0 and movedCount > 0 then
		active.startTime = tick()
	end

	-- Commit new state
	active.board = newBoard
	active.emptyIndex = newEmptyIndex
	active.moves += movedCount

	local solved = isSolved(newBoard)
	local bypass = (totalTiles < 16)

	if solved and not active.completed then
		-- EXTRA SECURITY: verify board integrity before accepting solve
		for i = 1, totalTiles do
			if active.board[i] ~= i then
				autoban(player, "Client reported solved but server board is not solved")
				return
			end
		end

		active.completed = true

		local solveTime = tick() - active.startTime
		local moves = active.moves
		-- Fix: 0-move solves should not add huge time
		if moves == 0 then
			solveTime = 0
		end
		-- Only autoban for truly impossible states
		if not bypass then
			if solveTime < 0 then
				autoban(player, "Negative solve time")
				return
			end
			if moves < 0 then
				autoban(player, "Negative moves")
				return
			end
			if totalTiles >= 16 and moves < 1 then
				autoban(player, "Solved puzzle with zero moves above 16 tiles")
				return
			end
			-- Slightly safer threshold; you can tune this
			if totalTiles >= 16 and solveTime < 0.1 then
				autoban(player, "Solve time impossibly fast")
				return
			end
		end

		-- Generate secure run token
		active.runToken = HttpService:GenerateGUID(false)

		-- Report validated run WITH token
		ValidatedRunEvent:Fire(
			player,
			rows,
			cols,
			solveTime,
			moves,
			active.mode,
			active.blindfold,
			active.runToken
		)

		-- Clear puzzle state after a short delay to avoid race with client
		task.delay(0.2, function()
			activePuzzle[player] = nil
		end)
	end

	-- Always tell client the result of this move
	SlideResult:FireClient(
		player,
		newBoard,
		movedCount,
		active.emptyIndex,
		active.moves,
		solved
	)
end)

