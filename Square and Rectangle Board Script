-- BLINDFOLD RESTORE (visual only)
-----------------
local function restoreBlindfold()
	if not blindfoldActive then return end

	local rows = rowsValue.Value
	local cols = colsValue.Value

	local patternColors = nil
	local mode = colorpatternMode.Value

	if mode == "Fringe" then
		patternColors = assignFringeColors(rows, cols)
	elseif mode == "Top/Bottom" then
		patternColors = assignTopBottom(rows, cols)
	elseif mode == "Left/Right" then
		patternColors = assignLeftRight(rows, cols)
	elseif mode == "4 Corners" then
		patternColors = assignFourCorners(rows, cols)
	end

	for i, tile in ipairs(tileOrder) do
		local isBlank = (tile.Text == "" and tile.BackgroundTransparency == 1)
		if isBlank then
			continue
		end

		local correct = correctIndexMap[tile]
		local row = math.ceil(correct / cols)
		local col = ((correct - 1) % cols) + 1

		if puzzleModeValue.Value == "Numbers" then
			local num = tonumber(tile.Name:match("%d+"))
			tile.Text = tostring(num)
		else
			tile.Text = ""
		end

		if puzzleModeValue.Value == "Images" and selectedImageIdValue.Value ~= "" then
			local img = tile:FindFirstChildOfClass("ImageLabel")
			if not img then
				img = Instance.new("ImageLabel")
				img.Parent = tile
				img.Size = UDim2.fromScale(1, 1)
				img.BackgroundTransparency = 1
				img.BorderSizePixel = 0
				img.Active = false
			end

			img.Image = "rbxassetid://" .. selectedImageIdValue.Value
			img.ScaleType = Enum.ScaleType.Crop

			local sliceW = 1024 / cols
			local sliceH = 1024 / rows

			img.ImageRectSize = Vector2.new(sliceW, sliceH)
			img.ImageRectOffset = Vector2.new(
				(col - 1) * sliceW,
				(row - 1) * sliceH
			)
		else
			local img = tile:FindFirstChildOfClass("ImageLabel")
			if img then img:Destroy() end
		end

		if mode == "Rows" then
			tile.BackgroundColor3 = getRowColor(row, rows)
		elseif mode == "Columns" then
			tile.BackgroundColor3 = getColumnColor(col, cols)
		elseif patternColors then
			tile.BackgroundColor3 = patternColors[correct]
		else
			tile.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		end

		tile.BackgroundTransparency = 0
		tile.BorderSizePixel = 0
	end

	blindfoldActive = false
end

----------------
-- BUILD PUZZLE (UI only, starts solved)
----------------
local function buildPuzzle(rows, cols)
	for _, child in ipairs(board:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	tileOrder = {}
	tileIndex = {}
	correctIndexMap = {}
	tileGrid = {}
	tileRC = {}

	local totalTiles = rows * cols

	local camera = workspace.CurrentCamera
	local screenH = camera.ViewportSize.Y

	local scale = getPuzzleScale(settingsFrame.PuzzleSize.Value)
	local baseSize = screenH * scale

	local puzzleW, puzzleH
	if rows == cols then
		puzzleW, puzzleH = baseSize, baseSize
	elseif cols > rows then
		puzzleW = baseSize
		puzzleH = baseSize * (rows / cols)
	else
		puzzleH = baseSize
		puzzleW = baseSize * (cols / rows)
	end

	puzzleW = math.floor(puzzleW / cols) * cols
	puzzleH = math.floor(puzzleH / rows) * rows

	board.Size = UDim2.fromOffset(puzzleW, puzzleH)

	local patternColors = nil
	local mode = colorpatternMode.Value

	if mode == "Fringe" then
		patternColors = assignFringeColors(rows, cols)
	elseif mode == "Top/Bottom" then
		patternColors = assignTopBottom(rows, cols)
	elseif mode == "Left/Right" then
		patternColors = assignLeftRight(rows, cols)
	elseif mode == "4 Corners" then
		patternColors = assignFourCorners(rows, cols)
	end

	local textPaddingScale = getTextPaddingScale(settingsFrame.TextSize.Value)

	for i = 1, totalTiles do
		local tile = Instance.new("TextButton")
		tile.Name = "Tile" .. i
		tile.Parent = board
		tile.LayoutOrder = i
		tile.TextScaled = true
		tile.Font = Enum.Font.GothamBold
		tile.BorderSizePixel = 0
		tile.AutoButtonColor = false

		local row = math.ceil(i / cols)
		local col = ((i - 1) % cols) + 1

		tileGrid[row] = tileGrid[row] or {}
		tileGrid[row][col] = tile
		tileRC[tile] = {row, col}

		correctIndexMap[tile] = i
		tileOrder[i] = tile
		tileIndex[tile] = i

		if i == totalTiles then
			tile.Text = ""
			tile.BackgroundTransparency = 1
			tile.Active = false
		elseif puzzleModeValue.Value == "Numbers" then
			tile.Text = tostring(i)

			local padding = Instance.new("UIPadding")
			padding.Parent = tile
			padding.PaddingTop = UDim.new(textPaddingScale, 0)
			padding.PaddingBottom = UDim.new(textPaddingScale, 0)
			padding.PaddingLeft = UDim.new(textPaddingScale, 0)
			padding.PaddingRight = UDim.new(textPaddingScale, 0)

			if mode == "Rows" then
				tile.BackgroundColor3 = getRowColor(row, rows)
			elseif mode == "Columns" then
				tile.BackgroundColor3 = getColumnColor(col, cols)
			elseif patternColors then
				tile.BackgroundColor3 = patternColors[i]
			else
				tile.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			end
		elseif puzzleModeValue.Value == "Images"
			and selectedImageIdValue.Value ~= "" then

			tile.Text = ""
			tile.BackgroundColor3 = Color3.fromRGB(255, 255, 255)

			local img = Instance.new("ImageLabel")
			img.Parent = tile
			img.Size = UDim2.fromScale(1, 1)
			img.BackgroundTransparency = 1
			img.BorderSizePixel = 0
			img.Active = false
			img.Image = "rbxassetid://" .. selectedImageIdValue.Value

			local sliceW = 1024 / cols
			local sliceH = 1024 / rows

			img.ImageRectSize = Vector2.new(sliceW, sliceH)
			img.ImageRectOffset = Vector2.new(
				(col - 1) * sliceW,
				(row - 1) * sliceH
			)
		end

		local aspect = Instance.new("UIAspectRatioConstraint")
		aspect.AspectRatio = 1
		aspect.Parent = tile
	end

	emptyIndex = findEmptyIndex()

	local grid = board:FindFirstChildOfClass("UIGridLayout")
	if not grid then
		grid = Instance.new("UIGridLayout")
		grid.Parent = board
	end

	grid.FillDirection = Enum.FillDirection.Horizontal
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.VerticalAlignment = Enum.VerticalAlignment.Center
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.CellPadding = UDim2.new(0, 0, 0, 0)
	grid.CellSize = UDim2.new(1 / cols, 0, 1 / rows, 0)

	for _, tile in ipairs(tileOrder) do
		tileConnections[tile] = {}

		local con1 = tile.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				pressedTile = tile
			end
		end)

		local con2 = tile.MouseEnter:Connect(function()
			if slidingModeValue.Value and not inputLocked then
				local idx = tileIndex[tile]
				if idx and idx ~= lastSlideIndex then
					lastSlideIndex = idx
					RequestSlide:FireServer(idx)
				end
			end
		end)

		table.insert(tileConnections[tile], con1)
		table.insert(tileConnections[tile], con2)
	end

	lockTiles()
end

----------------
-- PROCESS TILE (now just sends RequestSlide)
----------------
local function processTile(tile)
	if inputLocked then return end
	local index = tileIndex[tile]
	if not index then return end
	RequestSlide:FireServer(index)
end

----------------
-- INPUT HANDLING
----------------
local UIS = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if pressedTile and not slidingModeValue.Value then
			processTile(pressedTile)
		end
		pressedTile = nil
		return
	end

	if input.UserInputType == Enum.UserInputType.Touch then
		if pressedTile and not slidingModeValue.Value then
			processTile(pressedTile)
		end
		pressedTile = nil
		return
	end

	if input.KeyCode == Enum.KeyCode.ButtonA then
		local selected = GuiService.SelectedObject
		if selected and tileIndex[selected] and not slidingModeValue.Value then
			processTile(selected)
		end
	end
end)

if isTouchDevice then
	UIS.TouchStarted:Connect(function(touch)
		local pos = touch.Position
		local guiRoot = game:GetService("Players").LocalPlayer.PlayerGui
		local objs = guiRoot:GetGuiObjectsAtPosition(pos.X, pos.Y)

		for _, obj in ipairs(objs) do
			if tileIndex[obj] then
				pressedTile = obj
				break
			end
		end
	end)
end

