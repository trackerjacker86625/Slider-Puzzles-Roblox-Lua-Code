PuzzleInit.OnClientEvent:Connect(function(rows, cols, layout)
	-- Build fresh puzzle UI
	buildPuzzle(rows, cols)

	-- Apply server layout
	for pos, tileValue in ipairs(layout) do
		local tile = board:FindFirstChild("Tile" .. tileValue)
		if tile then
			tile.LayoutOrder = pos
		end
	end

	table.sort(tileOrder, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)

	rebuildGridFromOrder(rows, cols)
	emptyIndex = findEmptyIndex()

	inputLocked = false
	unlockTiles()
	moves = 0
	if not blindfoldedModeValue.Value then
		timerRunning = false
		elapsedTime = 0
		timerLabel.Text = "Time: 0:00.00"
	else
		-- Blindfold mode: timer already started on shuffle
		timerRunning = true
	end
end)

SlideResult.OnClientEvent:Connect(function(newBoard, movedCount, newEmptyIndex, newMoves, solved)
	local rows = rowsValue.Value
	local cols = colsValue.Value

	-- Update layout from server board array
	for pos, tileValue in ipairs(newBoard) do
		local tile = board:FindFirstChild("Tile" .. tileValue)
		if tile then
			tile.LayoutOrder = pos
		end
	end

	table.sort(tileOrder, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)

	rebuildGridFromOrder(rows, cols)

	emptyIndex = newEmptyIndex
	moves = newMoves
	movesLabel.Text = "Moves: " .. moves

	-- Start timer on first move (visual)
	if moves > 0 and not timerRunning then
		startTimer()
	end

	-- Blindfold: hide tiles on first move
	if blindfoldedModeValue.Value and moves == movedCount and movedCount > 0 and not blindfoldActive then
		blindfoldActive = true
		for _, tile in ipairs(tileOrder) do
			local isBlank = (tile.Text == "" and tile.BackgroundTransparency == 1)
			if not isBlank then
				tile.Text = ""
				local img = tile:FindFirstChildOfClass("ImageLabel")
				if img then img:Destroy() end
				tile.BackgroundColor3 = Color3.fromRGB(255, 93, 93)
				tile.BorderMode = Enum.BorderMode.Inset
				tile.BorderSizePixel = 1
				tile.BorderColor3 = Color3.fromRGB(0, 0, 0)
			end
		end
	end

	if solved then
		inputLocked = true
		stopTimer()
		lockTiles()
	end
end)

